<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs the SchoolHub server at login. Replace /PATH/TO/schoolhub with your own path,
     copy to ~/Library/LaunchAgents/, then:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.schoolhub.server.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.schoolhub.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/PATH/TO/schoolhub/.venv/bin/python</string>
    <string>/PATH/TO/schoolhub/server.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/PATH/TO/schoolhub/state/server.log</string>
  <key>StandardErrorPath</key><string>/PATH/TO/schoolhub/state/server.log</string>
</dict>
</plist>
